{
  "name": "@lets-contribute/api",
  "version": "1.0.0",
  "private": true,
  "main": "api/index.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p ../../packages/shared/tsconfig.json && nest build && node scripts/copy-dist.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:setup": "tsx src/db/setup.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
