# ---------------------------------------------------------------------------
# Let's Contribute — environment
# Copy to .env (same file is read by both apps) and fill in what you have.
# Everything is optional: without DATABASE_URL the API uses an in-memory store,
# and without GitHub OAuth credentials the app offers a clearly-labelled demo
# sign-in, so `npm run dev` always works.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED connection string (host contains "-pooler").
DATABASE_URL=

# Session / OAuth-state signing key. Generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-change-me-please

# GitHub OAuth App — https://github.com/settings/developers/new
# Homepage URL:      http://localhost:3000  (or your Vercel URL)
# Callback URL:      http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a personal access token to raise GitHub API rate limits for the
# repo-import preview (60 req/h unauthenticated, 5000 req/h with a token).
GITHUB_TOKEN=
# Optional override of the callback URL (defaults to $WEB_ORIGIN/api/auth/github/callback)
GITHUB_CALLBACK_URL=

# Public origin of the web app (redirects, CORS, cookie context)
WEB_ORIGIN=http://localhost:3000

# Where the Next.js server proxies /api/* to. On Vercel set this to the
# deployed API project URL, e.g. https://lets-contribute-api.vercel.app
API_URL=http://127.0.0.1:3001

# Demo sign-in: auto (only when GitHub OAuth is unconfigured) | on | off
DEMO_AUTH=auto

# Local API port
PORT=3001
